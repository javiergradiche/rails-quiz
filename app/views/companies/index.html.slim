h2 Companies

.mb-3
  = link_to 'New Company', new_company_path, class: 'btn btn-primary'

table.table
  thead
    tr
      th[scope="col"] Name
      th[scope="col"] Actions
  tbody
    - @companies.each do |company|
      tr
        td= company.name
        td
          .btn-group
            = link_to 'Edit', edit_company_path(company), class: 'btn btn-sm btn-outline-primary'